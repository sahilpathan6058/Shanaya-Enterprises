{
  "private": true,
  "scripts": {
    "dev": "npm --prefix my-react-app run dev",
    "dev:frontend": "npm --prefix my-react-app run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:full": "concurrently \"npm --prefix backend run dev\" \"npm --prefix my-react-app run dev\"",
    "server": "npm --prefix backend run start",
    "build": "npm --prefix my-react-app run build",
    "check:backend": "npm --prefix backend run check",
    "lint": "npm --prefix my-react-app run lint && npm --prefix backend run check",
    "preview": "npm --prefix my-react-app run preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
